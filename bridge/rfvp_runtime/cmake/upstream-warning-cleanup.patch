-        27, 29, 31, 33, 35, 37, 63,
-    ];
-    let step = STEP[(pquant as usize).min(31)];
-    let result = step * level.abs() + pquant;
-    if level > 0 {
-        result.clamp(-2048, 2047)
-    } else {
-        (-result).clamp(-2048, 2047)
