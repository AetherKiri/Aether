+/* Host-owned entrypoint used by the AetherKiri lifecycle fork. This keeps
+ * SDL_main -> Py_RunMain unchanged for the official launcher while exposing a
+ * separate path that initializes Python and returns to the host loop. */
+int renpy_mobile_bootstrap(const renpy_mobile_config_t *mobile_config,
+                          const renpy_mobile_host_t *host) {
+    if (!mobile_config || !host || mobile_config->struct_size < sizeof(*mobile_config) ||
+        host->struct_size < sizeof(*host) ||
+        mobile_config->abi_version != RENPY_MOBILE_LAUNCHER_ABI_VERSION ||
+        host->abi_version != RENPY_MOBILE_LAUNCHER_ABI_VERSION ||
+        !mobile_config->private_root_utf8 || !mobile_config->private_root_utf8[0]) {
+        return RENPY_MOBILE_INVALID_ARGUMENT;
+    }
+
+    init_environ();
+    setenv_workaround("RENPY_PLATFORM", PLATFORM "-" ARCH);
+    setenv_workaround("ANDROID_PRIVATE", mobile_config->private_root_utf8);
+    SDL_SetHint(SDL_HINT_ANDROID_BLOCK_ON_PAUSE, "0");
+
+    PyPreConfig preconfig;
+    PyConfig pyconfig;
+    PyImport_ExtendInittab(inittab);
+    init_librenpy();
+
+    char python[2048];
+    snprintf(python, sizeof(python), "%s/python", mobile_config->private_root_utf8);
+    char main_py[2048];
+    snprintf(main_py, sizeof(main_py), "%s/main.py", mobile_config->private_root_utf8);
+    char *argv[] = { python, main_py, NULL };
+
+    PyPreConfig_InitPythonConfig(&preconfig);
+    preconfig.utf8_mode = 1;
+    preconfig.use_environment = 0;
+    Py_PreInitializeFromBytesArgs(&preconfig, 2, argv);
+
+    PyConfig_InitPythonConfig(&pyconfig);
+    pyconfig.home = Py_DecodeLocale(mobile_config->private_root_utf8, NULL);
+    pyconfig.user_site_directory = 0;
+    pyconfig.parse_argv = 1;
+    pyconfig.install_signal_handlers = 0;
+    PyConfig_SetBytesArgv(&pyconfig, 2, argv);
+    Py_InitializeFromConfig(&pyconfig);
+
+    return renpy_mobile_init(mobile_config, host);
+}
