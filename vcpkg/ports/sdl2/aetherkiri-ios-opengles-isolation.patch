+++ b/src/video/uikit/SDL_uikitopengles.m
@@ -54,10 +54,17 @@
 
 void *UIKit_GL_GetProcAddress(_THIS, const char *proc)
 {
-    /* Look through all SO's for the proc symbol.  Here's why:
-     * -Looking for the path to the OpenGL Library seems not to work in the iOS Simulator.
-     * -We don't know that the path won't change in the future. */
+#if TARGET_OS_IOS && !TARGET_OS_MACCATALYST
+    /* The host can also load an isolated MetalANGLE runtime. Resolve only
+     * Apple's framework, whose EAGLContext owns this backend's contexts. */
+    if (!_this->gl_config.dll_handle) {
+        SDL_SetError("Apple OpenGLES library is not loaded");
+        return NULL;
+    }
+    return SDL_LoadFunction(_this->gl_config.dll_handle, proc);
+#else
     return dlsym(RTLD_DEFAULT, proc);
+#endif
 }
 
 /*
@@ -106,9 +113,35 @@ int UIKit_GL_LoadLibrary(_THIS, const char *path)
     if (path != NULL) {
         return SDL_SetError("iOS GL Load Library just here for compatibility");
     }
+#if TARGET_OS_IOS && !TARGET_OS_MACCATALYST
+    if (_this->gl_config.dll_handle) {
+        return 0;
+    }
+    @autoreleasepool {
+        /* NSBundle locates the loaded Apple framework in the actual device
+         * or Simulator runtime instead of assuming a system filesystem path. */
+        NSBundle *framework = [NSBundle bundleForClass:[EAGLContext class]];
+        NSString *executable = [framework executablePath];
+        if (!executable) {
+            return SDL_SetError("Could not locate Apple's loaded OpenGLES framework");
+        }
+        _this->gl_config.dll_handle = SDL_LoadObject([executable fileSystemRepresentation]);
+        if (!_this->gl_config.dll_handle) {
+            return -1;
+        }
+    }
+#endif
     return 0;
 }
 
+#if TARGET_OS_IOS && !TARGET_OS_MACCATALYST
+void UIKit_GL_UnloadLibrary(_THIS)
+{
+    SDL_UnloadObject(_this->gl_config.dll_handle);
+    _this->gl_config.dll_handle = NULL;
+}
+#endif
