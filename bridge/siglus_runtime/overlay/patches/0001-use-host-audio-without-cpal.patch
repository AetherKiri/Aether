diff --git a/Cargo.toml b/Cargo.toml
--- a/Cargo.toml
+++ b/Cargo.toml
@@ -48,4 +48,7 @@ image = { version = "0.24", default-features = false, features = ["png", "jpeg", "bmp", "dds"] }
