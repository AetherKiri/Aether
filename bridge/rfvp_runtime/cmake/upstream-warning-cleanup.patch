-fn iquant_uniform(level: i32, pquant: i32, halfqp: bool) -> i32 {
-    if level == 0 {
-        return 0;
-    }
-    let step = 2 * pquant;
-    let base = step * level.abs() + pquant;
-    let delta = if halfqp { pquant } else { 0 };
-    let result = if level > 0 {
-        base + delta
-    } else {
-        -(base + delta)
-    };
-    result.clamp(-2048, 2047)
