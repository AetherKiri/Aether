 from renpybuild.context import Context
 from renpybuild.task import task
+import shutil
 
 version = "3.12.8"
 
@@ -23,9 +24,15 @@
 
     c.run("""{{ make }} install""")
 
-    c.rmtree("{{ host }}/lib/python3.12/config-3.12-x86_64-linux-gnu/Tools/")
-    c.run("install -d {{ host }}/lib/python3.12/config-3.12-x86_64-linux-gnu/Tools/")
-    c.run("cp -a Tools/scripts {{ host }}/lib/python3.12/config-3.12-x86_64-linux-gnu/Tools/scripts")
+    configurations = list(c.path("{{ host }}/lib/python3.12").glob("config-3.12-*/"))
+    if not configurations:
+        raise RuntimeError("host Python did not install its configuration directory")
+    for configuration in configurations:
+        destination = configuration / "Tools" / "scripts"
+        if destination.exists():
+            shutil.rmtree(destination)
+        destination.parent.mkdir(parents=True, exist_ok=True)
+        shutil.copytree(c.path("Tools/scripts"), destination)
 
 
 
