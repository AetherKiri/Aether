@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# The exported libgdiplus::libgdiplus target references TIFF::TIFF in its
# link interface, so it must be defined before the targets are loaded.
find_dependency(TIFF)

if(@WITH_X11@)
    find_dependency(X11 COMPONENTS Xrender)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/libgdiplus-targets.cmake")

check_required_components(libgdiplus)
