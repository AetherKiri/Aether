{
  "name": "dead-end-aegis-title-and-dialogue",
  "launch_mode": "library",
  "backend": "Native Session",
  "coord_size": [1280, 720],
  "surface_size": [1280, 720],
  "steps": [
    {"type": "wait", "label": "game-warning", "until": [{"field": "mode", "equals": "logo"}, {"field": "probe_frame.width", "equals": 1280}]},
    {"type": "move", "x": 10, "y": 10, "after_frames": 40},
    {"type": "frame", "label": "visible-warning", "min_visible_ratio": 0.01},
    {"type": "key", "key_code": 13},
    {"type": "wait", "until": [{"field": "mode", "equals": "opening"}]},
    {"type": "key_until", "label": "reach-title", "until": [{"field": "title_ready", "equals": true}]},
    {"type": "click", "label": "new-story", "x": 230, "y": 445},
    {"type": "wait", "label": "first-line", "until": [{"field": "message", "equals": 65537}, {"field": "text_complete", "equals": true}]},
    {"type": "snapshot", "label": "original-line"},
    {"type": "frame_region", "label": "plain-notice-area", "rect": [1060, 538, 198, 25]},
    {"type": "click", "label": "message-window-save", "x": 1200, "y": 688, "after_frames": 30},
    {"type": "assert", "conditions": [{"field": "menu", "equals": 0}, {"field": "notice_number", "equals": 2}, {"field": "word", "same_as": "original-line.word"}]},
    {"type": "frame_region", "label": "save-notice", "rect": [1060, 538, 198, 25], "differs_from": "plain-notice-area"},
    {"type": "click", "label": "advance-on-body", "x": 501, "y": 610},
    {"type": "wait", "until": [{"field": "message", "equals": 65538}, {"field": "text_complete", "equals": true}]},
    {"type": "click", "label": "message-window-load", "x": 1200, "y": 640},
    {"type": "wait", "until": [{"field": "message", "same_as": "original-line.message"}, {"field": "word", "same_as": "original-line.word"}, {"field": "text_complete", "equals": true}]},
    {"type": "wait", "until": [{"field": "notice_number", "equals": 1}, {"field": "menu", "equals": 0}]},
    {"type": "move", "x": 40, "y": 40, "after_frames": 16},
    {"type": "frame_region", "label": "load-notice", "rect": [1060, 538, 198, 25], "differs_from": "save-notice"},
    {"type": "wait", "until": [{"field": "notice_number", "equals": 0}]},
    {"type": "frame_region", "label": "cleared-notice", "rect": [1060, 538, 198, 25], "matches": "plain-notice-area"},
    {"type": "click", "label": "open-system-menu", "x": 1170, "y": 585, "after_frames": 24},
    {"type": "wait", "until": [{"field": "system_menu_original", "equals": true}]},
    {"type": "click", "label": "manual-save", "x": 1090, "y": 100, "after_frames": 24},
    {"type": "wait", "until": [{"field": "slot_page", "equals": 1}]},
    {"type": "click", "label": "next-save-page", "x": 640, "y": 670, "after_frames": 24},
    {"type": "wait", "until": [{"field": "slot_page", "equals": 2}]},
    {"type": "click", "label": "previous-save-page", "x": 640, "y": 39, "after_frames": 24},
    {"type": "wait", "until": [{"field": "slot_page", "equals": 1}]},
    {"type": "click", "label": "save-manual-slot", "x": 875, "y": 109, "after_frames": 24},
    {"type": "click", "label": "accept-existing-slot", "x": 510, "y": 368, "after_frames": 24, "when": [{"field": "overwrite_slot", "equals": 1}]},
    {"type": "wait", "until": [{"field": "slot_page", "equals": 1}, {"field": "overwrite_slot", "equals": -1}]},
    {"type": "click", "label": "request-overwrite", "x": 875, "y": 109, "after_frames": 24},
    {"type": "wait", "until": [{"field": "overwrite_slot", "equals": 1}]},
    {"type": "click", "label": "cancel-overwrite", "x": 746, "y": 368, "after_frames": 24},
    {"type": "wait", "until": [{"field": "overwrite_slot", "equals": -1}, {"field": "slot_page", "equals": 1}]},
    {"type": "click", "label": "close-save", "x": 1145, "y": 678, "after_frames": 24},
    {"type": "wait", "until": [{"field": "menu", "equals": 0}]},
    {"type": "click", "label": "open-system-menu", "x": 1170, "y": 585, "after_frames": 24},
    {"type": "wait", "until": [{"field": "system_menu_original", "equals": true}]},
    {"type": "click", "label": "load-menu", "x": 1090, "y": 147, "after_frames": 24},
    {"type": "wait", "until": [{"field": "slot_page", "equals": 1}]},
    {"type": "click", "label": "next-load-page", "x": 640, "y": 670, "after_frames": 24},
    {"type": "wait", "until": [{"field": "slot_page", "equals": 2}]},
    {"type": "click", "label": "previous-load-page", "x": 640, "y": 39, "after_frames": 24},
    {"type": "wait", "until": [{"field": "slot_page", "equals": 1}]},
    {"type": "click", "label": "choose-manual-slot", "x": 875, "y": 109, "after_frames": 24},
    {"type": "wait", "until": [{"field": "menu", "equals": 0}, {"field": "message", "equals": 65537}, {"field": "text_complete", "equals": true}]},
    {"type": "click", "label": "open-system-menu", "x": 1170, "y": 585, "after_frames": 24},
    {"type": "wait", "until": [{"field": "system_menu_original", "equals": true}]},
    {"type": "click", "label": "history", "x": 1090, "y": 240, "after_frames": 24},
    {"type": "wait", "until": [{"field": "menu", "equals": 6}]},
    {"type": "frame", "label": "authored-backlog", "min_visible_ratio": 0.12},
    {"type": "click", "label": "leave-history", "x": 1145, "y": 678, "after_frames": 24},
    {"type": "wait", "until": [{"field": "menu", "equals": 0}]},
    {"type": "click", "label": "open-system-menu", "x": 1170, "y": 585, "after_frames": 24},
    {"type": "wait", "until": [{"field": "system_menu_original", "equals": true}]},
    {"type": "click", "label": "hide-dialogue", "x": 1090, "y": 289, "after_frames": 24},
    {"type": "wait", "until": [{"field": "ui_hidden", "equals": true}]},
    {"type": "click", "label": "reveal-dialogue", "x": 502, "y": 610, "after_frames": 24},
    {"type": "wait", "until": [{"field": "ui_hidden", "equals": false}, {"field": "message", "equals": 65537}]},
    {"type": "click", "label": "open-system-menu", "x": 1170, "y": 585, "after_frames": 24},
    {"type": "wait", "until": [{"field": "system_menu_original", "equals": true}]},
    {"type": "click", "label": "resume-dialogue", "x": 1090, "y": 428, "after_frames": 24},
    {"type": "wait", "until": [{"field": "menu", "equals": 0}, {"field": "message", "equals": 65537}]},
    {"type": "click", "label": "open-system-menu", "x": 1170, "y": 585, "after_frames": 24},
    {"type": "wait", "until": [{"field": "system_menu_original", "equals": true}]},
    {"type": "click", "label": "auto-play", "x": 1090, "y": 382, "after_frames": 24},
    {"type": "wait", "until": [{"field": "menu", "equals": 0}, {"field": "auto_mode", "equals": 1}]},
    {"type": "wait", "until": [{"field": "message", "changed_from": "original-line.message"}], "timeout_ms": 45000},
    {"type": "key", "key_code": 13},
    {"type": "wait", "until": [{"field": "auto_mode", "equals": 0}]},
    {"type": "key", "key_code": 120},
    {"type": "wait", "until": [{"field": "message", "equals": 65537}, {"field": "text_complete", "equals": true}]},
    {"type": "click", "label": "open-system-menu", "x": 1170, "y": 585, "after_frames": 24},
    {"type": "wait", "until": [{"field": "system_menu_original", "equals": true}]},
    {"type": "click", "label": "text-skip", "x": 1090, "y": 333, "after_frames": 24},
    {"type": "wait", "until": [{"field": "menu", "equals": 0}]},
    {"type": "wait", "until": [{"field": "message", "changed_from": "original-line.message"}], "timeout_ms": 10000},
    {"type": "click", "label": "stop-skip-on-dialogue", "x": 502, "y": 610, "after_frames": 2},
    {"type": "key_until", "label": "return-to-manual-playback", "until": [{"field": "skip_active", "equals": false}], "interval_frames": 2},
    {"type": "key", "key_code": 120},
    {"type": "wait", "until": [{"field": "message", "equals": 65537}, {"field": "text_complete", "equals": true}]},
    {"type": "click", "label": "message-window-menu", "x": 1170, "y": 585},
    {"type": "wait", "until": [{"field": "system_menu_original", "equals": true}]},
    {"type": "frame", "label": "authored-system-menu", "min_visible_ratio": 0.2},
    {"type": "click", "label": "system-menu-settings", "x": 1110, "y": 190},
    {"type": "wait", "until": [{"field": "settings_page", "equals": 1}]},
    {"type": "key", "key_code": 27},
    {"type": "wait", "until": [{"field": "menu", "equals": 0}, {"field": "word", "same_as": "original-line.word"}]},
    {"type": "click", "x": 1170, "y": 585},
    {"type": "wait", "until": [{"field": "system_menu_original", "equals": true}]},
    {"type": "click", "label": "system-menu-end", "x": 1080, "y": 553},
    {"type": "wait", "until": [{"field": "return_title_dialog", "equals": true}]},
    {"type": "click", "label": "cancel-return-to-title", "x": 750, "y": 365},
    {"type": "wait", "until": [{"field": "menu", "equals": 0}, {"field": "word", "same_as": "original-line.word"}]},
    {"type": "exit_to_library"},
    {"type": "wait", "until": [{"field": "host.library_visible", "equals": true}]},
    {"type": "reopen"},
    {"type": "key_until", "until": [{"field": "title_ready", "equals": true}]},
    {"type": "click", "label": "title-continue", "x": 492, "y": 445},
    {"type": "wait", "until": [{"field": "mode", "equals": "story"}, {"field": "word", "same_as": "original-line.word"}, {"field": "message", "same_as": "original-line.message"}]}
  ]
}
