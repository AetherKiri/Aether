+# AetherKiri cooperative host hook skeleton. This state is deliberately opt-in:
+# the normal Ren'Py launcher remains unchanged until a native/mobile fork calls
+# these helpers and handles CooperativeYield.
+_cooperative_deadline = None
+
+
+def cooperative_begin_tick(budget_ms):
+    """Start an opt-in bounded host tick and return its monotonic deadline."""
+    global _cooperative_deadline
+    if budget_ms is None or budget_ms < 0:
+        _cooperative_deadline = None
+    else:
+        _cooperative_deadline = time.monotonic() + (budget_ms / 1000.0)
+    return _cooperative_deadline
+
+
+def cooperative_tick_expired():
+    """Return true when the opt-in host tick budget has elapsed."""
+    return _cooperative_deadline is not None and time.monotonic() >= _cooperative_deadline
+
+
+def cooperative_end_tick():
+    """Clear the opt-in host tick deadline."""
+    global _cooperative_deadline
+    _cooperative_deadline = None
+
+
+def cooperative_shutdown():
+    """Release Ren'Py resources without terminating the host process.
+
+    This is a shutdown *hook* for an embedding fork. It intentionally does not
+    call the Android ``finishAndRemoveTask``/``System.exit`` path in bootstrap.
+    The native fork must call it only after the Python interpreter is quiescent.
+    """
+    try:
+        renpy.display.tts.tts(None)
+    except Exception:
+        pass
+    try:
+        if renpy.display.draw:
+            renpy.display.im.cache.quit()
+            renpy.display.draw.quit()
+    except Exception:
+        pass
+    try:
+        renpy.audio.audio.quit()
+    except Exception:
+        pass
+    cooperative_end_tick()
+
+
