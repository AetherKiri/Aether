[configuration]
entry_symbol = "aether_kiri_library_init"
compatibility_minimum = "4.6"

[libraries]
windows.debug.x86_64 = "res://bin/windows/debug/aether_kiri_godot.dll"
windows.release.x86_64 = "res://bin/windows/release/aether_kiri_godot.dll"
linux.debug.x86_64 = "res://bin/linux/debug/libaether_kiri_godot.so"
linux.release.x86_64 = "res://bin/linux/release/libaether_kiri_godot.so"
macos.debug = "res://bin/macos/debug/libaether_kiri_godot.dylib"
macos.release = "res://bin/macos/release/libaether_kiri_godot.dylib"
ios.debug = "res://bin/ios/debug/libaether_kiri_godot.a"
ios.release = "res://bin/ios/release/libaether_kiri_godot.a"
ios.ios_simulator.debug = "res://bin/ios-simulator/debug/libaether_kiri_godot.a"
ios.ios_simulator.ios_simulator_x64.debug = "res://bin/ios-simulator-x64/debug/libaether_kiri_godot.a"
android.debug.arm64 = "res://bin/android/arm64-v8a/debug/libaether_kiri_godot.so"
android.debug.x86_64 = "res://bin/android/x86_64/debug/libaether_kiri_godot.so"
android.release.arm64 = "res://bin/android/arm64-v8a/release/libaether_kiri_godot.so"
web.debug.wasm32 = "res://bin/web/debug/aether_kiri_godot.wasm"
web.release.wasm32 = "res://bin/web/release/aether_kiri_godot.wasm"

[dependencies]
windows.debug.x86_64 = {
  "res://bin/windows/debug/engine_api.dll": ""
}
windows.release.x86_64 = {
  "res://bin/windows/release/engine_api.dll": ""
}
linux.debug.x86_64 = {
  "res://bin/linux/debug/libengine_api.so": ""
}
linux.release.x86_64 = {
  "res://bin/linux/release/libengine_api.so": ""
}
macos.debug = {
  "res://bin/macos/debug/libengine_api.dylib": ""
}
macos.release = {
  "res://bin/macos/release/libengine_api.dylib": ""
}

android.debug.arm64 = {
  "res://bin/android/arm64-v8a/debug/libengine_api.so": "",
  "res://bin/android/arm64-v8a/debug/libSDL2.so": "",
  "res://bin/android/arm64-v8a/debug/libomp.so": ""
}
android.release.arm64 = {
  "res://bin/android/arm64-v8a/release/libengine_api.so": "",
  "res://bin/android/arm64-v8a/release/libSDL2.so": "",
  "res://bin/android/arm64-v8a/release/libomp.so": ""
}
android.debug.x86_64 = {
  "res://bin/android/x86_64/debug/libengine_api.so": "",
  "res://bin/android/x86_64/debug/libSDL2.so": "",
  "res://bin/android/x86_64/debug/libomp.so": ""
}
