 /**
  * This is called from the launcher executable, to start Ren'Py running.
  */
+/* Host-owned entrypoint used by the AetherKiri lifecycle fork. The Renios
+ * prototype's launcher_main remains unchanged for the official app target. */
+int EXPORT renpy_mobile_bootstrap(const renpy_mobile_config_t *mobile_config,
+                                  const renpy_mobile_host_t *host) {
+    if (!mobile_config || !host || mobile_config->struct_size < sizeof(*mobile_config) ||
+        host->struct_size < sizeof(*host) ||
+        mobile_config->abi_version != RENPY_MOBILE_LAUNCHER_ABI_VERSION ||
+        host->abi_version != RENPY_MOBILE_LAUNCHER_ABI_VERSION ||
+        !mobile_config->argv0_utf8 || !mobile_config->argv0_utf8[0]) {
+        return RENPY_MOBILE_INVALID_ARGUMENT;
+    }
+
+    char *argv[] = { (char *)mobile_config->argv0_utf8, NULL };
+    preinitialize(1, 1, argv);
+    set_renpy_platform();
+    take_argv0(argv[0]);
+    search_python_home();
+
+    config.user_site_directory = 0;
+    config.parse_argv = 1;
+    config.install_signal_handlers = 0;
+    search_pyname();
+
+    char **new_argv = (char **)alloca(2 * sizeof(char *));
+    new_argv[0] = argv[0];
+    new_argv[1] = pyname;
+    PyConfig_SetBytesArgv(&config, 2, new_argv);
+    Py_InitializeFromConfig(&config);
+
+    return renpy_mobile_init(mobile_config, host);
+}
