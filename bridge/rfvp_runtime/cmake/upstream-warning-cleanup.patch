-
-fn iquant_nonuniform(level: i32, pquant: i32) -> i32 {
-    if level == 0 {
-        return 0;
-    }
-    // Non-uniform quantizer step table from SMPTE 421M Table 3
-    const STEP: [i32; 32] = [
