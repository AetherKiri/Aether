    {
      "type": "frame",
      "label": "story_after_20"
    },
    {
      "type": "exit_to_library",
      "label": "exit_game"
    },
    {
      "type": "assert",
      "label": "runtime_destroyed",
      "conditions": [
        {
          "field": "host.library_visible",
          "equals": true
        },
        {
          "field": "host.engine_initialized",
          "equals": false
        },
        {
          "field": "host.frame_texture_cleared",
          "equals": true
        },
        {
          "field": "host.game_running",
          "equals": false
        }
      ]
    },
    {
      "type": "reopen",
      "label": "reopen_same_game",
      "after_frames": 2400
    },
    {
      "type": "assert",
      "label": "fresh_runtime_ready",
      "conditions": [
        {
          "field": "host.library_visible",
          "equals": false
        },
        {
          "field": "host.engine_initialized",
          "equals": true
        },
        {
          "field": "host.game_running",
          "equals": true
        },
        {
          "field": "host.render_errors",
          "equals": 0
        }
      ]
    },
    {
      "type": "frame",
      "label": "title_after_reopen"
    },
    {
      "type": "exit_to_library",
      "label": "exit_again"
    },
    {
      "type": "assert",
      "label": "second_runtime_destroyed",
      "conditions": [
        {
          "field": "host.library_visible",
          "equals": true
        },
        {
          "field": "host.engine_initialized",
          "equals": false
        },
        {
          "field": "host.frame_texture_cleared",
          "equals": true
        }
      ]
    }
  ]
}
