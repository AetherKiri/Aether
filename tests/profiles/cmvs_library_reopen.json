{
  "name": "cmvs-library-reopen-after-20",
  "probe_script": "res://scripts/runtime_regression_probe.gd",
  "launch_mode": "library",
  "surface_width": 1280,
  "surface_height": 720,
  "window_width": 1280,
  "window_height": 720,
  "coord_width": 1280,
  "coord_height": 720,
  "fps_limit": 60,
  "steps": [
    {
      "type": "snapshot",
      "label": "opened",
      "after_frames": 2400
    },
    {
      "type": "frame",
      "label": "title_before",
      "min_visible_ratio": 0.1
    },
    {
      "type": "click",
      "label": "start_game",
      "x": 640,
      "y": 280,
      "after_frames": 3600
    },
