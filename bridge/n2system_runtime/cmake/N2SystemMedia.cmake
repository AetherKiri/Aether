# The C# bindings share one private FFmpeg 8 image built from the same target
# packages as the engine. Referencing entry points retains their archive objects
# and normal dependencies, without whole-archiving unrelated FFmpeg libraries.
find_package(FFMPEG REQUIRED)
add_library(aether_n2system_media SHARED "${CMAKE_CURRENT_LIST_DIR}/../src/n2system_media_anchor.c")
target_include_directories(aether_n2system_media PRIVATE ${FFMPEG_INCLUDE_DIRS} "${CMAKE_CURRENT_BINARY_DIR}")
set_target_properties(aether_n2system_media PROPERTIES OUTPUT_NAME aether_n2system_media LINKER_LANGUAGE CXX)

# FindFFMPEG includes all enabled components, plus platform and codec dependencies.
# Omit device/filter archives, keeping its configuration selectors and transitive
# dependency list intact. CMake accepts framework paths as link libraries.
set(_n2_media_libraries "")
set(_n2_media_configuration "")
foreach(_n2_library IN LISTS FFMPEG_LIBRARIES)
    if(_n2_library MATCHES "^(optimized|debug|general)$")
        set(_n2_media_configuration "${_n2_library}")
        continue()
    endif()
    if(NOT _n2_library MATCHES "(^|[/\\\\])(lib)?(avdevice|avfilter|postproc)d?([.\\-].*)?$")
        if(_n2_media_configuration)
            list(APPEND _n2_media_libraries "${_n2_media_configuration}")
        endif()
        list(APPEND _n2_media_libraries "${_n2_library}")
    endif()
    set(_n2_media_configuration "")
endforeach()
target_link_libraries(aether_n2system_media PRIVATE ${_n2_media_libraries})
if(APPLE)
    # FFmpeg's subtitle and MPEG-TS objects use the platform iconv API, which
    # vcpkg's FindFFMPEG dependency list does not currently carry on macOS.
    find_package(Iconv REQUIRED)
    target_link_libraries(aether_n2system_media PRIVATE Iconv::Iconv)
endif()

set(_n2_media_binding "${AETHERKIRI_N2SYSTEM_DIR}/third_party/FFmpeg.AutoGen/FFmpeg.functions.g.cs")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_n2_media_binding}")
file(STRINGS "${_n2_media_binding}" _n2_media_declarations REGEX "public static extern")
set(_n2_media_symbols "")
foreach(_n2_declaration IN LISTS _n2_media_declarations)
    string(REGEX MATCH "(av[a-z_]*|swr[a-z_]*|sws[a-z_]*)[A-Za-z0-9_]*\\(" _n2_symbol "${_n2_declaration}")
    string(REPLACE "(" "" _n2_symbol "${_n2_symbol}")
    if(_n2_symbol)
        list(APPEND _n2_media_symbols "${_n2_symbol}")
    endif()
endforeach()
list(REMOVE_DUPLICATES _n2_media_symbols)
if(NOT _n2_media_symbols)
    message(FATAL_ERROR "No N2System FFmpeg P/Invoke entry points were found")
endif()
set(_n2_media_references "")
set(_n2_media_exports "EXPORTS\n")
set(_n2_media_apple_exports "_aether_n2system_media_anchor\n")
set(_n2_media_elf_exports "{ global: aether_n2system_media_anchor;\n")
foreach(_n2_symbol IN LISTS _n2_media_symbols)
    string(APPEND _n2_media_references "N2SYSTEM_MEDIA_SYMBOL(${_n2_symbol})\n")
    string(APPEND _n2_media_exports "${_n2_symbol}\n")
    string(APPEND _n2_media_apple_exports "_${_n2_symbol}\n")
    string(APPEND _n2_media_elf_exports "${_n2_symbol};\n")
endforeach()
file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/n2system_media_symbols.inc" "${_n2_media_references}")
if(WIN32)
    file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/n2system_media.def" "${_n2_media_exports}")
    target_sources(aether_n2system_media PRIVATE "${CMAKE_CURRENT_BINARY_DIR}/n2system_media.def")
    set_target_properties(aether_n2system_media PROPERTIES PREFIX "")
elseif(APPLE)
    file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/n2system_media.exports" "${_n2_media_apple_exports}")
    target_link_options(aether_n2system_media PRIVATE "LINKER:-exported_symbols_list,${CMAKE_CURRENT_BINARY_DIR}/n2system_media.exports")
    set_property(TARGET aether_n2system_media APPEND PROPERTY LINK_DEPENDS "${CMAKE_CURRENT_BINARY_DIR}/n2system_media.exports")
elseif(CMAKE_SYSTEM_NAME STREQUAL "Linux")
    string(APPEND _n2_media_elf_exports "local: *; };\n")
    file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/n2system_media.exports" "${_n2_media_elf_exports}")
    target_link_options(aether_n2system_media PRIVATE "LINKER:--version-script=${CMAKE_CURRENT_BINARY_DIR}/n2system_media.exports")
    set_property(TARGET aether_n2system_media APPEND PROPERTY LINK_DEPENDS "${CMAKE_CURRENT_BINARY_DIR}/n2system_media.exports")
endif()
