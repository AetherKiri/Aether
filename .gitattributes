# Set default behaviour to automatically normalize line endings.
* text=auto

# Enforce LF for vcpkg patch files, as patch.exe on Windows fails with CRLF line endings
*.patch text eol=lf
# Empty context lines in unified diffs must retain their leading space.
bridge/renpy_runtime/mobile_launcher/patches/**/*.patch whitespace=-blank-at-eol,-space-before-tab

# Product game archives are binary assets.
*.xp3 -text

# Preserve the upstream KAG3 demo scripts byte-for-byte, including legacy whitespace.
demos/aetherkiri-kag3/data/** whitespace=-blank-at-eol,-blank-at-eof,-space-before-tab
