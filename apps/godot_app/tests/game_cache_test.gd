extends SceneTree

const Cache = preload("res://scripts/game_cache.gd")
const Storage = preload("res://scripts/game_library_storage.gd")

func put(path: String, text: String) -> void:
    assert(DirAccess.make_dir_recursive_absolute(path.get_base_dir()) == OK)
    var file := FileAccess.open(path, FileAccess.WRITE)
    assert(file != null)
    file.store_string(text)
    file.close()

func _initialize() -> void:
    var fixture := DirAccess.create_temp("aether-game-cache")
    var base := fixture.get_current_dir()
    var game := base.path_join("Games/One")
    var other := base.path_join("Games/Two")
    put(game.path_join("savedata/slot"), "save")
    put(other.path_join("savedata/slot"), "other save")
    var paths := Cache.paths(base, game, "yuris")
    var other_paths := Cache.paths(base, other, "yuris")
    put(paths[0].path_join("data"), "12345")
    put(paths[1].path_join(".partial"), "12")
    put(other_paths[0].path_join("data"), "other cache")
    assert(Cache.paths(base, "", "yuris").is_empty())
    assert(Cache.directory(base, game) == Cache.directory(base, game + "/../One/"))
    assert(Cache.directory(base, game).get_file().begins_with("One--"))
    assert(Cache.directory(base, game) != Cache.directory(base, base.path_join("Other/One")))
    assert(Cache.directory("/sandbox/old/Documents", "/sandbox/old/Documents/Games/One").get_file() == Cache.directory("/sandbox/new/Documents", "/sandbox/new/Documents/Games/One").get_file())
    assert(Cache.measure(paths).bytes == 7)
    if OS.get_name() in ["macOS", "Linux"]:
        assert(DirAccess.open(paths[0]).create_link(other, "linked") == OK)
        assert(Cache.measure(paths).bytes == 7)
    assert(Cache.clear(paths).error == OK)
    assert(Cache.measure(paths).bytes == 0)
    assert(FileAccess.get_file_as_string(game.path_join("savedata/slot")) == "save")
    assert(FileAccess.get_file_as_string(other.path_join("savedata/slot")) == "other save")
    assert(Cache.measure(other_paths).bytes == 11)
    # Historical path-hashed caches move without rewriting the extracted data.
    var legacy_game := base.path_join("Games/Legacy")
    var legacy_paths := Cache.paths(base, legacy_game, "yuris")
    put(legacy_paths[1].path_join("media"), "legacy data")
    assert(Cache.prepare(base, legacy_game, "yuris").error == OK)
    assert(FileAccess.get_file_as_string(legacy_paths[0].path_join("media")) == "legacy data")
    assert(not DirAccess.dir_exists_absolute(legacy_paths[1]))
    assert(Cache.prepare(base, legacy_game, "yuris").path == legacy_paths[0])
    # Global cleanup also finds abandoned legacy banks, but keeps their saves.
    put(base.path_join("yuris/orphan/cache/audio"), "old")
    put(base.path_join("yuris/orphan/gsd.sd"), "legacy save")
    put(base.path_join("systemc_games/orphan/cache/movie"), "old movie")
    put(base.path_join("systemc_games/orphan/save.dat"), "systemc save")
    put(base.path_join("tyrano_cache/orphan/project/index.html"), "html")
    put(base.path_join("renpy_sessions/old-session/project/game/story.rpy"), "mirror")
    put(other.path_join("savedata/_engine/compiled/story.rpyc"), "save statement ids")
    put(base.path_join("cache/advhd-audio-old-crashed/0.ogg"), "old audio")
    put(base.path_join("settings.cfg"), "settings")
    var global := Cache.all_paths(base)
    assert(Cache.measure(global).bytes > Cache.measure(other_paths).bytes)
    assert(Cache.measure(PackedStringArray([other_paths[0], other_paths[0], other_paths[0].path_join("data")])).bytes == 11)
    assert(Cache.clear(global).error == OK)
    assert(Cache.measure(global).bytes == 0)
    assert(FileAccess.get_file_as_string(other.path_join("savedata/slot")) == "other save")
    assert(FileAccess.get_file_as_string(other.path_join("savedata/_engine/compiled/story.rpyc")) == "save statement ids")
    assert(FileAccess.get_file_as_string(base.path_join("yuris/orphan/gsd.sd")) == "legacy save")
    assert(FileAccess.get_file_as_string(base.path_join("systemc_games/orphan/save.dat")) == "systemc save")
    assert(FileAccess.get_file_as_string(base.path_join("settings.cfg")) == "settings")
    put(paths[0].path_join("regenerated"), "cache")
    assert(Cache.delete_with_cache(game, base.path_join("Games"), paths) == OK)
    assert(not DirAccess.dir_exists_absolute(game))
    assert(Cache.measure(paths).bytes == 0)
    assert(Cache.measure(other_paths).bytes == 0)
    if OS.get_name() in ["macOS", "Linux"]:
        assert(DirAccess.remove_absolute(base.path_join("cache/games")) == OK)
        assert(DirAccess.make_dir_recursive_absolute(base.path_join("cache")) == OK)
        assert(DirAccess.open(base.path_join("cache")).create_link(other, "games") == OK)
        assert(Cache.prepare(base, other, "yuris").error != OK)
        assert(Cache.clear(Cache.paths(base, other, "yuris")).error == OK)
        assert(FileAccess.get_file_as_string(other.path_join("savedata/slot")) == "other save")
    assert(Storage._remove_entry(base) == OK)
    print("GAME_CACHE_OK: game isolation, size, hidden cache, links, saves, permanent deletion")
    quit()
