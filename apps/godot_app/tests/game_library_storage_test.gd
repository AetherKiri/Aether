extends SceneTree

const Storage = preload("res://scripts/game_library_storage.gd")

func _initialize() -> void:
    var fixture := ProjectSettings.globalize_path("user://game-delete-test-%d" % Time.get_ticks_usec())
    var games := fixture.path_join("Games")
    var game := games.path_join("Example")
    var other := games.path_join("Other")
    var outside := fixture.path_join("outside")
    for directory in [game.path_join("data"), game.path_join("savedata"), game.path_join(".hidden"), other, outside]:
        assert(DirAccess.make_dir_recursive_absolute(directory) == OK)
    for path in [game.path_join("data/script.dat"), game.path_join("savedata/save001.dat"), game.path_join(".hidden/config"), other.path_join("keep.txt"), outside.path_join("keep.txt")]:
        var file := FileAccess.open(path, FileAccess.WRITE)
        assert(file != null)
        file.store_string("test fixture")
        file.close()
    assert(Storage.deletion_target(game.path_join("data/script.dat"), games) == game)
    assert(Storage.delete_game(games, games) == ERR_INVALID_PARAMETER)
    assert(Storage.delete_game(games.path_join("../outside"), games) == ERR_INVALID_PARAMETER)
    assert(Storage.delete_game(games + "-sibling/Example", games) == ERR_INVALID_PARAMETER)
    if OS.get_name() in ["macOS", "Linux"]:
        assert(DirAccess.open(game).create_link(outside, "linked-data") == OK)
        assert(DirAccess.open(games).create_link(outside, "Alias") == OK)
        assert(Storage.delete_game(games.path_join("Alias"), games) == OK)
        assert(FileAccess.file_exists(outside.path_join("keep.txt")))
    assert(Storage.delete_game(game, games) == OK)
    assert(not DirAccess.dir_exists_absolute(game))
    assert(FileAccess.file_exists(other.path_join("keep.txt")))
    assert(FileAccess.file_exists(outside.path_join("keep.txt")))
    assert(Storage.delete_game(game, games) == OK)
    var archive := games.path_join("standalone.xp3")
    var file := FileAccess.open(archive, FileAccess.WRITE)
    file.store_string("archive fixture")
    file.close()
    assert(Storage.delete_game(archive, games) == OK)
    assert(DirAccess.dir_exists_absolute(games))
    assert(FileAccess.file_exists(other.path_join("keep.txt")))
    assert(Storage.delete_game(other, games) == OK)
    assert(DirAccess.remove_absolute(outside.path_join("keep.txt")) == OK)
    assert(DirAccess.remove_absolute(outside) == OK)
    assert(DirAccess.remove_absolute(games) == OK)
    assert(DirAccess.remove_absolute(fixture) == OK)
    print("GAME_LIBRARY_DELETE_OK: complete folder, saves, hidden files and link boundaries")
    quit()
