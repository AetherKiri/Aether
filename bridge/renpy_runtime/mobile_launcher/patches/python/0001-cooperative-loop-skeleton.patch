diff --git a/renpy/aether_mobile.py b/renpy/aether_mobile.py
new file mode 100644
index 00000000..017f1fb5
--- /dev/null
+++ b/renpy/aether_mobile.py
@@ -0,0 +1,300 @@
+"""Host-owned Ren'Py loop; all SDL/GL work stays on the calling thread.
+
+The native launcher links greenlet with its target CPython. No exception is
+used to yield: the complete script, screen and Cython stacks remain suspended.
+"""
+import importlib.util
+import os
+import sys
+import threading
+import time
+
+try:
+    from _aether_greenlet import getcurrent, greenlet
+except ImportError:
+    getcurrent = greenlet = None
+
+_owner = None
+_host = None
+_game = None
+_deadline = None
+_frame = None
+_serial = 0
+_paused = False
+_stopping = False
+_error = None
+_input = []
+_buttons = [False, False, False]
+_pointer = (0, 0)
+_surface_size = None
+_keys = {}
+_modifiers = 0
+
+
+def cooperative_active():
+    return _game is not None
+
+
+def _check_owner():
+    if _owner is not None and threading.get_ident() != _owner:
+        raise RuntimeError("Ren'Py mobile SDL/GL must run on its original host thread")
+
+
+def cooperative_start(game_root, argv0):
+    """Create a suspended game. Initialization starts inside the first tick."""
+    global _owner, _host, _game, _paused, _stopping, _error, _frame, _serial
+    if greenlet is None:
+        raise RuntimeError("Target CPython is missing the linked greenlet runtime")
+    if _game is not None:
+        raise RuntimeError("Ren'Py mobile game is already started")
+    if not os.path.isdir(game_root) or not os.path.isfile(argv0):
+        raise ValueError("game directory or packaged Ren'Py bootstrap is missing")
+    _owner = threading.get_ident()
+    _host = getcurrent()
+    _paused = _stopping = False
+    _error = _frame = None
+    _serial = 0
+    _game = greenlet(lambda: _run(game_root, argv0), parent=_host)
+
+
+def _run(game_root, argv0):
+    global _error
+    saved_argv = sys.argv
+    try:
+        # Use the official distributor path functions and full bootstrap,
+        # including import_all, importer, init script, preferences and saves.
+        sys.argv = [argv0, game_root]
+        spec = importlib.util.spec_from_file_location("_aether_renpy_entry", argv0)
+        entry = importlib.util.module_from_spec(spec)
+        sys.modules[spec.name] = entry
+        spec.loader.exec_module(entry)
+        entry.main()
+    except SystemExit as exc:
+        if exc.code not in (None, 0):
+            _error = "Ren'Py exited with status %r" % (exc.code,)
+    except BaseException:
+        import traceback
+        _error = traceback.format_exc()
+    finally:
+        sys.argv = saved_argv
+        sys.modules.pop("_aether_renpy_entry", None)
+    return "finished" if _error is None else "error"
+
+
+def cooperative_tick(budget_ms):
+    global _deadline
+    _check_owner()
+    if _game is None:
+        return "not_started"
+    if _game.dead:
+        if _error:
+            raise RuntimeError(_error)
+        return "finished"
+    if _paused:
+        return "yield"
+    _deadline = time.monotonic() + max(0, budget_ms) / 1000.0
+    try:
+        _game.switch()
+    finally:
+        _deadline = None
+    if _error:
+        raise RuntimeError(_error)
+    return "finished" if _game.dead else "yield"
+
+
+def cooperative_checkpoint(force=False):
+    """Suspend at an engine boundary without unwinding the game stack."""
+    if not cooperative_active() or getcurrent() is not _game:
+        return
+    if _stopping:
+        import renpy.game
+        raise renpy.game.QuitException()
+    if force or (_deadline is not None and time.monotonic() >= _deadline):
+        _host.switch("yield")
+        if _stopping:
+            import renpy.game
+            raise renpy.game.QuitException()
+    _dispatch_input()
+
+
+def cooperative_capture(surftree):
+    global _frame, _serial
+    if not cooperative_active():
+        return
+    import renpy
+    import renpy.pygame as pygame
+    surface = renpy.display.draw.screenshot(surftree)
+    if surface.get_bytesize() != 4:
+        raise RuntimeError("Ren'Py screenshot must contain RGBA pixels")
+    # The official GL2 screenshot writes RGBA bytes and flips to top-left.
+    # Ren'Py pygame deliberately has no image.tostring/get_view API.
+    pixels = surface.aether_copy_pixels()
+    width, height = surface.get_size()
+    if len(pixels) != width * height * 4:
+        raise RuntimeError("Invalid packed Ren'Py frame size")
+    _serial += 1
+    _frame = (pixels, width, height, _serial)
+    window = pygame.display.get_window()
+    if window is not None:
+        # Binding uses the actual renderer window, never a synthetic surface.
+        import _aether_host
+        if _aether_host.bind_window(window.get_sdl_window_pointer().value) != 0:
+            raise RuntimeError("Could not bind Ren'Py renderer window")
+    cooperative_checkpoint(force=True)
+
+
+def cooperative_set_surface_size(width, height):
+    """Select the initial pbuffer; the host scales frames after viewport resize."""
+    global _surface_size
+    _check_owner()
+    if width <= 0 or height <= 0:
+        raise ValueError("Invalid host surface size")
+    if _frame is None:
+        _surface_size = (int(width), int(height))
+
+
+def cooperative_surface_size():
+    return _surface_size
+
+
+def cooperative_frame():
+    _check_owner()
+    return _frame
+
+
+def cooperative_input(event):
+    _check_owner()
+    if _game is None or _game.dead:
+        raise RuntimeError("Ren'Py mobile game is not running")
+    # Copy borrowed native text/event storage before returning to the host.
+    _input.append(dict(event))
+
+
+def _dispatch_input():
+    global _pointer, _modifiers
+    if not _input:
+        return
+    import renpy
+    import renpy.pygame as pygame
+    queued = list(_input)
+    del _input[:]
+    for item in queued:
+        kind, action = item["type"], item["value"]
+        if kind == 3:
+            text = item.get("text", "")
+            if text:
+                pygame.event.post(pygame.event.Event(pygame.TEXTINPUT, text=text))
+        elif kind == 1:
+            key = item["code"]
+            if action == 8:
+                key = pygame.K_ESCAPE
+                action = 5
+            _keys[key] = action == 5
+            _modifiers = item.get("modifiers", 0)
+            pygame.event.post(pygame.event.Event(
+                pygame.KEYDOWN if action == 5 else pygame.KEYUP,
+                key=key, mod=item.get("modifiers", 0), unicode="",
+                repeat=bool(item.get("repeat", False))))
+        elif kind == 2:
+            # Frames contain the rendered game tree, excluding window letterbox.
+            # Convert normalized game content through GL2's actual viewport;
+            # the normal mouse_event path translates this back to virtual pixels.
+            pos = renpy.display.draw.untranslate_point(
+                item["x"] * renpy.config.screen_width,
+                item["y"] * renpy.config.screen_height)
+            button = item.get("code", 1) or 1
+            if action in (1, 3):
+                if 1 <= button <= 3:
+                    _buttons[button - 1] = action == 1
+                pygame.event.post(pygame.event.Event(
+                    pygame.MOUSEBUTTONDOWN if action == 1 else pygame.MOUSEBUTTONUP,
+                    pos=pos, button=button, which=4294967295, touch=True))
+            elif action == 2:
+                rel = (pos[0] - _pointer[0], pos[1] - _pointer[1])
+                pygame.event.post(pygame.event.Event(
+                    pygame.MOUSEMOTION, pos=pos, rel=rel,
+                    buttons=tuple(_buttons), which=4294967295, touch=True))
+            elif action == 4:
+                wheel_y = item.get("delta_y", 0)
+                if pygame.event.get_mousewheel_buttons():
+                    if wheel_y:
+                        wheel_button = 4 if wheel_y > 0 else 5
+                        for event_type in (pygame.MOUSEBUTTONDOWN, pygame.MOUSEBUTTONUP):
+                            pygame.event.post(pygame.event.Event(
+                                event_type, pos=pos, button=wheel_button,
+                                which=4294967295, touch=True))
+                else:
+                    pygame.event.post(pygame.event.Event(
+                        pygame.MOUSEWHEEL, x=item.get("delta_x", 0),
+                        y=wheel_y, flipped=False))
+            _pointer = pos
+
+
+def cooperative_mouse_pos():
+    return _pointer
+
+
+def cooperative_mouse_pressed():
+    return tuple(_buttons)
+
+
+def cooperative_key_pressed(key):
+    return bool(_keys.get(key, False))
+
+
+def cooperative_modifiers():
+    return _modifiers
+
+
+def cooperative_set_modifiers(value):
+    global _modifiers
+    _modifiers = value
+
+
+def cooperative_pause():
+    global _paused
+    _check_owner()
+    if _game is None or _game.dead:
+        return
+    import renpy
+    if renpy.display.interface and renpy.display.interface.started:
+        renpy.display.interface.mobile_save()
+        renpy.audio.audio.pause_all()
+    _paused = True
+
+
+def cooperative_resume():
+    global _paused
+    _check_owner()
+    if _game is None or _game.dead:
+        return
+    import renpy
+    if renpy.display.interface and renpy.display.interface.started:
+        renpy.audio.audio.unpause_all()
+        renpy.display.interface.force_redraw = True
+    _paused = False
+
+
+def cooperative_text_input_state():
+    if not cooperative_active():
+        return False
+    import renpy.pygame as pygame
+    return bool(pygame.key.text_input)
+
+
+def cooperative_stop():
+    global _game, _host, _owner, _paused, _stopping, _frame
+    _check_owner()
+    if _game is None:
+        return
+    _stopping = True
+    _paused = False
+    try:
+        if not _game.dead:
+            import renpy.game
+            _game.throw(renpy.game.QuitException())
+    finally:
+        _game = _host = _owner = _frame = None
+        _input.clear()
+        _keys.clear()
+        _buttons[:] = [False, False, False]
