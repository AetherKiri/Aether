{
  "name": "dead-end-aegis-original-settings",
  "launch_mode": "library",
  "backend": "Native Session",
  "coord_size": [1280, 720],
  "surface_size": [1280, 720],
  "steps": [
    {"type": "wait", "until": [{"field": "mode", "equals": "title"}, {"field": "probe_frame.width", "equals": 1280}]},
    {"type": "assert", "conditions": [{"field": "host.engine_host", "equals": "native"}, {"field": "host.runtime", "equals": "systemnnn"}]},
    {"type": "click", "label": "open-settings", "x": 1000, "y": 445},
    {"type": "wait", "until": [{"field": "settings_page", "equals": 1}]},
    {"type": "move", "label": "settle-settings-background", "x": 10, "y": 10, "after_frames": 240},
    {"type": "frame_region", "label": "original-music-switch", "rect": [482, 116, 50, 24]},
    {"type": "click", "label": "toggle-music", "x": 504, "y": 125},
    {"type": "move", "x": 10, "y": 10, "after_frames": 6},
    {"type": "frame_region", "label": "toggled-music-switch", "rect": [482, 116, 50, 24], "differs_from": "original-music-switch"},
    {"type": "click", "label": "text-tab", "x": 155, "y": 180},
    {"type": "wait", "until": [{"field": "settings_page", "equals": 2}]},
    {"type": "frame", "label": "text-page", "min_visible_ratio": 0.35},
    {"type": "click", "label": "extras-tab", "x": 155, "y": 235},
    {"type": "wait", "until": [{"field": "settings_page", "equals": 3}]},
    {"type": "click", "label": "return-to-title", "x": 1145, "y": 660},
    {"type": "wait", "until": [{"field": "settings_page", "equals": 0}, {"field": "mode", "equals": "title"}]},
    {"type": "exit_to_library"},
    {"type": "wait", "until": [{"field": "host.library_visible", "equals": true}]},
    {"type": "reopen"},
    {"type": "wait", "until": [{"field": "mode", "equals": "title"}, {"field": "probe_frame.width", "equals": 1280}, {"field": "host.frame_texture_cleared", "equals": false}]},
    {"type": "click", "x": 1000, "y": 445},
    {"type": "wait", "until": [{"field": "settings_page", "equals": 1}]},
    {"type": "move", "label": "settle-reopened-background", "x": 10, "y": 10, "after_frames": 240},
    {"type": "frame_region", "label": "persisted-music-switch", "rect": [482, 116, 50, 24], "matches": "toggled-music-switch"},
    {"type": "click", "x": 504, "y": 125},
    {"type": "key", "key_code": 27},
    {"type": "wait", "until": [{"field": "settings_page", "equals": 0}, {"field": "mode", "equals": "title"}]}
  ]
}
